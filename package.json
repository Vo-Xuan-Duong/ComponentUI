{
  "name": "componentui",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "Fluent Calm Design System — local-first cross-framework foundation",
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "syntax:check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "check": "npm run tokens:check && npm run syntax:check && npm run quality:check && npm test",
    "preview": "node scripts/serve.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "packages:verify": "node scripts/verify-packages.mjs",
    "pack:local": "node scripts/pack-packages.mjs",
    "check:packages": "npm run build:packages && npm run packages:verify",
    "quality:check": "node scripts/check-quality.mjs",
    "benchmark:data": "node scripts/benchmark-data.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  }
}
