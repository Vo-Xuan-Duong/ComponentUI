{
  "version": 1,
  "status": "preview",
  "name": "PasswordField",
  "tag": "cu-password-field",
  "type": "form",
  "features": [
    "native password input",
    "show/hide Lucide icons",
    "auto-complete",
    "constraint validation",
    "form reset"
  ],
  "attributes": {
    "name": "string",
    "label": "string",
    "hint": "string",
    "error": "string",
    "required": "boolean",
    "disabled": "boolean",
    "readonly": "boolean",
    "minlength": "number",
    "maxlength": "number",
    "pattern": "string",
    "autocomplete": "current-password|new-password"
  },
  "properties": {
    "value": "string — property only, not reflected to HTML",
    "visible": "readonly boolean"
  },
  "methods": [
    "focus",
    "toggleVisibility",
    "checkValidity",
    "reportValidity"
  ],
  "events": [
    "cu-input",
    "cu-change",
    "cu-visibility-change"
  ],
  "accessibility": {
    "label": "visible label targeting native input",
    "visibility": "aria-pressed toggle button with Show/Hide accessible name",
    "invalid": "aria-invalid; ElementInternals validity"
  },
  "security": "Do not store, log or reflect password values into DOM attributes"
}
