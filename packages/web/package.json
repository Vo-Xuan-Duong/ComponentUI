{
  "name": "@componentui/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "ComponentUI framework-neutral Web Components and DOM interaction controllers",
  "exports": {
    ".": "./src/interactions.js",
    "./interactions": "./src/interactions.js",
    "./components": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/index.js"
    },
    "./components/button": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/button.js"
    },
    "./components/text-field": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/text-field.js"
    },
    "./components/checkbox": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/checkbox.js"
    },
    "./components/switch": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/switch.js"
    },
    "./components/dialog": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/dialog.js"
    },
    "./components/select": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/select.js"
    },
    "./components/radio-group": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/radio-group.js"
    },
    "./components/tabs": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/tabs.js"
    },
    "./components/tooltip": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/tooltip.js"
    },
    "./components/popover": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/popover.js"
    }
  }
}
